---
import '../styles/landing.css';
---

<!doctype html>
<html lang="es" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>OpenRed Bolivia</title>
<meta name="description" content="Nuestro nuevo sitio web está en camino.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2228%22 fill=%22%2310b981%22/></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Geist:wght@300;500&display=swap" rel="stylesheet">
<script is:inline>
  (function() {
    const theme = localStorage.getItem('theme');
    if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
</head>
<body>
<div class="bl"><i></i><i></i><i></i></div>
<canvas id="fx"></canvas>
<div class="cur" id="cur"></div>
<div class="grain"></div>
<div class="mq" aria-hidden="true"><div id="mq"></div></div>
<div class="app">
<header>
<div class="mk" id="ini">OR</div>
<div class="header-right">
  <div class="pill"><span><s></s><b id="st" style="font-weight:500">Sitio en desarrollo</b></span></div>
  <button id="theme-btn" class="theme-btn" aria-label="Cambiar tema" title="Cambiar tema">
    <svg id="theme-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></svg>
  </button>
</div>
</header>
<main>
<h1 id="ttl">OpenRed Bolivia</h1>
<p class="sub" id="sub">Nuestro nuevo sitio web está en camino.</p>
<div class="cta">
<a class="btn" id="wa" href="https://wa.me/59176115022" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
<a class="btn g" id="ac" href="#" hidden></a>
<a class="btn g" id="em" href="#" hidden>Enviar correo</a>
</div>
</main>
<footer><span id="cp"></span><span id="adr"></span></footer>
</div>
<script>
  import '../scripts/landing.js';
</script>
</body>
</html>
